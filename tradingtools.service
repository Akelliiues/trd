[Unit]
Description=TradingTools Workstation & Production API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/trd.ssotansum.com
ExecStart=/usr/bin/python3 /var/www/trd.ssotansum.com/production_server.py
Restart=always
RestartSec=3
Environment=PORT=3000

# Security & Sandboxing
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
